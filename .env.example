# Runtime
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
LOG_LEVEL=info
SESSION_TTL_DAYS=30

# PostgreSQL (Neon or another managed PostgreSQL provider)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/portopedia?sslmode=require

# Authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Portopedia\n\n# Optional one-time administrator bootstrap\nBOOTSTRAP_ADMIN_EMAIL=
