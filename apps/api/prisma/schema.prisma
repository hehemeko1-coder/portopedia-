generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PortfolioVisibility {
  PRIVATE
  PUBLIC
}

enum ProjectVisibility {
  PRIVATE
  PUBLIC
}

enum AssetStatus {
  PENDING
  READY
  FAILED
}

enum OAuthProvider {
  GOOGLE
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  emailVerifiedAt DateTime?
  displayName     String
  username        String       @unique
  passwordHash    String?
  avatarAssetId   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  portfolio       Portfolio?
  sessions        Session[]
  oauthAccounts   OAuthAccount[]
  assets          Asset[]      @relation("UserAssets")
  avatarAsset     Asset?       @relation("UserAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Portfolio {
  id          String              @id @default(cuid())
  userId      String              @unique
  title       String
  headline    String?
  biography   String?             @db.Text
  location    String?
  websiteUrl  String?
  visibility  PortfolioVisibility @default(PRIVATE)
  publishedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects    Project[]

  @@index([visibility, publishedAt])
}

model Project {
  id           String            @id @default(cuid())
  portfolioId  String
  title        String
  slug         String
  summary      String?           @db.VarChar(500)
  description  String?           @db.Text
  coverAssetId String?
  visibility   ProjectVisibility @default(PRIVATE)
  sortOrder    Int               @default(0)
  publishedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  portfolio    Portfolio         @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  coverAsset   Asset?            @relation("ProjectCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  assets       Asset[]           @relation("ProjectAssets")

  @@unique([portfolioId, slug])
  @@index([portfolioId, visibility, sortOrder])
  @@index([visibility, publishedAt])
}

model Asset {
  id             String      @id @default(cuid())
  ownerId        String
  projectId      String?
  storageKey     String      @unique
  originalName   String
  mimeType       String
  sizeBytes      BigInt
  checksumSha256 String?
  status         AssetStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  owner          User        @relation("UserAssets", fields: [ownerId], references: [id], onDelete: Cascade)
  project        Project?    @relation("ProjectAssets", fields: [projectId], references: [id], onDelete: SetNull)
  coverFor       Project[]   @relation("ProjectCover")
  avatarFor      User[]      @relation("UserAvatar")

  @@index([ownerId, createdAt])
  @@index([projectId])
  @@index([status, createdAt])
}
